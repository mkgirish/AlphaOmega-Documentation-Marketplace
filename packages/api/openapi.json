{
  "openapi": "3.1.0",
  "info": {
    "title": "Visitor Registration API",
    "version": "0.0.0",
    "description": "Committed OpenAPI document for CMP-3 (AD-4). Regenerated from the Fastify route schemas by `npm run openapi`; the openapi-regenerated gate proves this file matches. ST-1: the liveness probe, the registration screen and its bundle. Every response carries the AD-16 security headers; any other route answers 404 with the NotFound envelope. ST-11: POST /api/registrations, which refuses cross-site (403), non-JSON (415), oversized (413) and invalid (400) requests before anything is stored."
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness probe, or the registration screen when the client accepts text/html.",
        "responses": {
          "200": {
            "description": "The API is up (JSON), or the registration screen (HTML).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected failure; no detail is returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "The registration screen has not been built into this image.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/assets/{file}": {
      "get": {
        "operationId": "getAsset",
        "summary": "A fingerprinted file of the registration screen's bundle; {file} may span nested directories under assets/.",
        "parameters": [
          {
            "name": "file",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file, cached as immutable.",
            "content": {
              "text/javascript": {
                "schema": {
                  "type": "string"
                }
              },
              "text/css": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {}
              },
              "image/svg+xml": {
                "schema": {
                  "type": "string"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string"
                }
              },
              "image/gif": {
                "schema": {
                  "type": "string"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string"
                }
              },
              "image/x-icon": {
                "schema": {
                  "type": "string"
                }
              },
              "font/woff": {
                "schema": {
                  "type": "string"
                }
              },
              "font/woff2": {
                "schema": {
                  "type": "string"
                }
              },
              "font/ttf": {
                "schema": {
                  "type": "string"
                }
              },
              "application/octet-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No such file.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected failure; no detail is returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/registrations": {
      "post": {
        "operationId": "createRegistration",
        "summary": "Record a visitor registration. Write-only: no route reads registrations back.",
        "parameters": [
          {
            "name": "Sec-Fetch-Site",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Anything but same-origin or none is refused with 403."
          }
        ],
        "requestBody": {
          "required": true,
          "description": "At most 4096 bytes of application/json.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Kept. The response never carries the row id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationCreated"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON, a body that is not an object or has an unexpected field (fields is {}), or invalid values (one message per invalid field). Messages never repeat a submitted value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "403": {
            "description": "A cross-site request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "The body is over 4096 bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected failure; no detail is returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Registrations cannot be saved right now.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "message"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "RegistrationInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "firstName",
          "lastName",
          "email",
          "phone"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "maxLength": 100,
            "description": "Trimmed, internal whitespace collapsed; no control or format characters."
          },
          "lastName": {
            "type": "string",
            "maxLength": 100,
            "description": "Trimmed, internal whitespace collapsed; no control or format characters."
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "description": "A 10-digit NANP number without +1; spaces, parentheses, dots and dashes are ignored."
          }
        }
      },
      "RegistrationCreated": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "createdAt"
            ],
            "properties": {
              "createdAt": {
                "type": "string",
                "description": "UTC seconds, formatted by formatUtcSeconds()."
              }
            }
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "fields"
        ],
        "properties": {
          "error": {
            "type": "string",
            "const": "validation"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "No such route or file.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    }
  }
}
