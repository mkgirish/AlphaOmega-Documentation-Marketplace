{
  "openapi": "3.1.0",
  "info": {
    "title": "Visitor Registration API",
    "version": "0.0.0",
    "description": "Committed OpenAPI document for CMP-3 (AD-4). Regenerated from the Fastify route schemas by `npm run openapi`; the openapi-regenerated gate proves this file matches. ST-1: the liveness probe, the registration screen and its bundle. ST-9: POST /api/registrations applies the shared registration rules. Every response carries the AD-16 security headers; any other route answers 404 with the NotFound envelope."
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness probe, or the registration screen when the client accepts text/html.",
        "responses": {
          "200": {
            "description": "The API is up (JSON), or the registration screen (HTML).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected failure; no detail is returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "The registration screen has not been built into this image.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/assets/{file}": {
      "get": {
        "operationId": "getAsset",
        "summary": "A fingerprinted file of the registration screen's bundle; {file} may span nested directories under assets/.",
        "parameters": [
          {
            "name": "file",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file, cached as immutable.",
            "content": {
              "text/javascript": {
                "schema": {
                  "type": "string"
                }
              },
              "text/css": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {}
              },
              "image/svg+xml": {
                "schema": {
                  "type": "string"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string"
                }
              },
              "image/gif": {
                "schema": {
                  "type": "string"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string"
                }
              },
              "image/x-icon": {
                "schema": {
                  "type": "string"
                }
              },
              "font/woff": {
                "schema": {
                  "type": "string"
                }
              },
              "font/woff2": {
                "schema": {
                  "type": "string"
                }
              },
              "font/ttf": {
                "schema": {
                  "type": "string"
                }
              },
              "application/octet-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No such file.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected failure; no detail is returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/registrations": {
      "post": {
        "operationId": "createRegistration",
        "summary": "Record a visitor registration, validated against the shared registration rules.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stored. Only the whole-second UTC time is returned; never the row id or a submitted value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationCreated"
                }
              }
            }
          },
          "400": {
            "description": "The body is not valid JSON, not an object, or breaks a field rule; fields names each failing field and nothing is stored.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "The body is larger than the limit; nothing is stored.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json; nothing is stored.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected failure, such as the database being unavailable; no detail is returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "description": "Narrows IF-2 createRegistration under the write-only-surface gate: the 201 body carries neither the row id nor any submitted value. Unknown body fields are ignored."
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      },
      "RegistrationInput": {
        "type": "object",
        "required": [
          "fullName",
          "email"
        ],
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320
          }
        }
      },
      "RegistrationCreated": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "createdAt"
            ],
            "properties": {
              "createdAt": {
                "type": "string",
                "description": "UTC seconds, formatted by formatUtcSeconds()."
              }
            }
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "message"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "No such route or file.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    }
  }
}
