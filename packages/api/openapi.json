{
  "openapi": "3.1.0",
  "info": {
    "title": "Visitor Registration API",
    "version": "0.0.0",
    "description": "Committed OpenAPI document for CMP-3 (AD-4). Regenerated from the Fastify route schemas by `npm run openapi`; the openapi-regenerated gate proves this file matches. ST-1: the registration screen and its bundle, served beside IF-2's liveness answer."
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "getHealth",
        "summary": "The registration screen for browsers (Accept: text/html); the liveness probe otherwise.",
        "responses": {
          "200": {
            "description": "The registration screen (text/html), or the liveness answer (application/json).",
            "content": {
              "text/html": { "schema": { "type": "string" } },
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ok"],
                  "properties": { "ok": { "type": "boolean" } }
                }
              }
            }
          },
          "503": {
            "description": "The registration screen's build is not present.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    },
    "/assets/{file}": {
      "get": {
        "operationId": "getScreenAsset",
        "summary": "One content-hashed file of the registration screen's bundle.",
        "parameters": [{ "name": "file", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$" } }],
        "responses": {
          "200": {
            "description": "The asset.",
            "content": {
              "text/javascript": { "schema": { "type": "string" } },
              "text/css": { "schema": { "type": "string" } },
              "image/svg+xml": { "schema": { "type": "string" } },
              "image/png": { "schema": { "type": "string", "format": "binary" } },
              "image/x-icon": { "schema": { "type": "string", "format": "binary" } },
              "font/woff2": { "schema": { "type": "string", "format": "binary" } }
            }
          },
          "404": {
            "description": "No such asset.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["message"],
            "properties": { "message": { "type": "string" } }
          }
        }
      }
    }
  }
}
